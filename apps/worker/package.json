{
  "name": "@nucleus/worker",
  "version": "0.0.1",
  "private": true,
  "description": "Sensu Nucleus — MQTT subscriber for Eview pendant events",
  "main": "dist/index.js",
  "scripts": {
    "prisma:generate": "prisma generate --schema=../web/prisma/schema.prisma",
    "build": "pnpm prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "echo 'worker lint — covered by typecheck for now' && exit 0",
    "typecheck": "pnpm prisma:generate && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.1.0",
    "mqtt": "5.10.3",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/web-push": "3.6.4",
    "prisma": "6.1.0",
    "typescript": "5.7.2"
  }
}
