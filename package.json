{
  "name": "nucleus",
  "version": "0.0.1",
  "private": true,
  "description": "Sensu Nucleus — unified platform monorepo",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "build": "pnpm -r --filter='./apps/*' build",
    "dev": "pnpm --filter @nucleus/web dev",
    "lint": "pnpm -r --parallel lint",
    "typecheck": "pnpm -r --parallel typecheck",
    "test:e2e": "pnpm --filter @nucleus/e2e test"
  }
}
